rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每個用戶只可以讀寫自己嘅資料。
    // member（true / "luna" / "sol"）同 owned（已買報告）只可以由你喺控制台或者付款系統（Cloudflare Worker）設定；
    // credits（占卜次數）用戶自己只可以每次減 1，唔可以加。
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['member', 'owned', 'credits', 'memberSource', 'stripeSub', 'stripeCustomer', 'rcProduct']);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['member', 'owned', 'memberSource', 'stripeSub', 'stripeCustomer', 'rcProduct'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits'])
                        || (resource.data.credits is int && request.resource.data.credits == resource.data.credits - 1
                            && request.resource.data.credits >= 0));
      // 用戶可以喺 app 入面刪除自己嘅帳戶（App Store 規定）
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // payments/* 只有伺服器（Worker）寫，用嚟防止同一個付款通知重複入帳；用戶睇唔到。
  }
}
